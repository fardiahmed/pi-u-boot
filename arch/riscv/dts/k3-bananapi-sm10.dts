/*
 * Banana Pi BPI-SM10: SpacemiT K3-CoM260 module on the CoM260 kit V02 carrier.
 * From the Pico-ITX board and SpacemiT's k3_com260.dtsi / k3_com260_kit_v02.dts.
 */

/dts-v1/;

#include "k3.dtsi"
#include <dt-bindings/usb/pd.h>

/ {
	model = "Banana Pi BPI-SM10";
	compatible = "bananapi,bpi-sm10", "spacemit,k3-com260", "spacemit,k3";
};

&pinctrl {
	qspi_grp {
		power-source = <1800>;
	};

	qspi_cs0_grp {
		power-source = <1800>;
	};

	i2c0_0_grp {
		power-source = <3300>;
	};

	i2c2_1_grp {
		power-source = <1800>;
	};

	pinctrl_dp1_3: dp1_3_grp {
		pinctrl-single,pins = <
			K3_PADCONF(GPIO_72, MUX_MODE4, (EDGE_NONE | PULL_DIS | PAD_DS8)) /* dp1_hpd */
		>;
		power-source = <3300>;
	};
};

&uart0 {
	status = "okay";
};

/* USB-C: FUSB301 role and orientation for the download / fastboot port */
&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c0_0>;
	status = "okay";

	tcpc@25 {
		compatible = "fcs,fusb301";
		reg = <0x25>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			source-pdos = <PDO_FIXED(5000, 2500, PDO_FIXED_USB_COMM)>;
			sink-pdos = <PDO_FIXED(5000, 1400, PDO_FIXED_USB_COMM)>;
			op-sink-microwatt = <15000000>;
			self-powered;

			port {
				fusb301_sw_ep: endpoint {
					remote-endpoint = <&typec_orient_sw>;
				};
			};
		};
	};
};

/* Carrier EEPROM: ONIE TLV with the product name ("k3_com260_kit_v02") */
&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c2_1>;
	status = "okay";

	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		status = "okay";
	};
};

&usb3_porta_u2phy {
	status = "okay";
};

&usb3_porta_u3phy {
	orientation-switch;
	status = "okay";

	port {
		typec_orient_sw: endpoint {
			remote-endpoint = <&fusb301_sw_ep>;
		};
	};
};

&usb3_porta {
	status = "okay";

	dwc3@cad00000 {
		dr_mode = "peripheral";
	};
};

&ufs {
	status = "okay";
};

/* Module SPI-NOR: bootinfo, FSBL, env, ESOS, OpenSBI and U-Boot */
&qspi {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_qspi &pinctrl_qspi_cs0>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <26500000>;
		m25p,fast-read;
		broken-flash-reset;
		status = "okay";
	};
};

&i2c8 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c8>;
	spacemit,sda-glitch-nofix;
	status = "okay";

	spm8821: pmic@41 {
		compatible = "spacemit,spm8821", "spacemit,p1";
		reg = <0x41>;
		bus = <8>;

		regulators {
			/* buck */
			dcdc_1: DCDC_REG1 {
				regulator-name = "dcdc1";
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1050000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <1050000>;
				};
			};

			dcdc_2: DCDC_REG2 {
				regulator-name = "dcdc2";
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1050000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <1050000>;
				};
			};

			dcdc_3: DCDC_REG3 {
				regulator-name = "dcdc3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <800000>;
				};
			};

			dcdc_4: DCDC_REG4 {
				regulator-name = "dcdc4";
				regulator-min-microvolt = <2100000>;
				regulator-max-microvolt = <2100000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <2100000>;
				};
			};

			dcdc_5: DCDC_REG5 {
				regulator-name = "dcdc5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <1800000>;
				};
			};

			dcdc_6: DCDC_REG6 {
				regulator-name = "dcdc6";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <600000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <500000>;
				};
			};

			/* aldo */
			ldo_1: LDO_REG1 {
				regulator-name = "ldo1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <1800000>;
				};
			};

			ldo_2: LDO_REG2 {
				regulator-name = "ldo2";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <1800000>;
				};
			};

			ldo_3: LDO_REG3 {
				regulator-name = "ldo3";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3400000>;
				regulator-state-mem {
					regulator-suspend-microvolt = <3300000>;
				};
			};

			ldo_4: LDO_REG4 {
				regulator-name = "ldo4";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <3300000>;
				};
			};

			/* dldo */
			ldo_5: LDO_REG5 {
				regulator-name = "ldo5";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <1200000>;
				};
			};

			ldo_6: LDO_REG6 {
				regulator-name = "ldo6";
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <900000>;
				};
			};

			ldo_7: LDO_REG7 {
				regulator-name = "ldo7";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <800000>;
				};
			};

			ldo_8: LDO_REG8 {
				regulator-name = "ldo8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <1800000>;
				};
			};

			ldo_9: LDO_REG9 {
				regulator-name = "ldo9";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <1800000>;
				};
			};

			ldo_10: LDO_REG10 {
				regulator-name = "ldo10";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <1800000>;
				};
			};

			ldo_11: LDO_REG11 {
				regulator-name = "ldo11";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <1800000>;
				};
			};

			sw_2: SWITCH_REG1 {
				regulator-name = "switch1";
			};

			power_event: SWITCH_REG2 {
				regulator-name = "pwr-event";
			};

			power_int: SWITCH_REG3 {
				regulator-name = "pwr-int";
			};

			rtc_ctrl: SWITCH_REG4 {
				regulator-name = "rtc-ctrl";
			};

			rtc_event: SWITCH_REG5 {
				regulator-name = "rtc-event";
			};

			rtc_irq: SWITCH_REG6 {
				regulator-name = "rtc-irq";
			};

			power_down: SWITCH_REG7 {
				regulator-name = "power-down";
			};

			reboot_flag: SWITCH_REG8 {
				regulator-name = "reboot-flag";
			};

			wdt_pm8821: PMIC_WDT {
				wdt-name = "wdt_pm8821";
			};
		};
	};

	/* Kit V02 CPU rail regulator, set by the SPL */
	mpq8655: mpq8655@30 {
		compatible = "spacemit,mpq8655";
		reg = <0x30>;
		bus = <8>;

		regulators {
			edcdc_1: EDCDC_REG1 {
				regulator-name = "edcdc1";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1000000>;
				regulator-init-microvolt = <880000>;
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

/*
 * Display: DP1 to the DisplayPort connector; no eDP panel on this carrier, so
 * only crtc1 / dp1 are described.
 */
&dpu {
	/*
	 * Keep the display off in U-Boot. The kernel brings the DPU and the DP
	 * link up on its own, so the splash buys nothing, and leaving the PHY
	 * configured here only adds a state the kernel has to undo.
	 */
	status = "disabled";

	dpu_out: port {
		#address-cells = <1>;
		#size-cells = <0>;

		dpu_out_dp1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&dp1_in_dpu>;
		};
	};
};

&dp1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_dp1_3>;
	status = "okay";

	ports {
		dp1_in: port {
			#address-cells = <1>;
			#size-cells = <0>;

			dp1_in_dpu: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&dpu_out_dp1>;
			};
		};
	};
};
